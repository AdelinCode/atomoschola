{
  "name": "eduplatform",
  "version": "1.0.0",
  "description": "Educational platform with backend API",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run mongodb\" \"npm run server\"",
    "mongodb": "mongod --dbpath ./backend/data/db",
    "server": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "seed": "node backend/scripts/seed.js"
  },
  "keywords": [
    "education",
    "learning",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^1.14.10"
  }
}
